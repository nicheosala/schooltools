# Copia questo file in `schooltools.env` e mettici le tue credenziali Spaggiari.
# `schooltools.env` e' ignorato da git.
SPAGGIARI_UTENTE=il-tuo-codice-personale
SPAGGIARI_PASSWORD=la-tua-password
# In alternativa alla password in chiaro, un comando che la stampa su stdout,
# per esempio dal database di KeePassXC (chiede la password del database):
# SPAGGIARI_PASSWORD_COMANDO=keepassxc-cli show -s -a Password ~/Passwords.kdbx Spaggiari
